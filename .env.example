# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=tipapp.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml defaults)
DB_NAME=tipapp
DB_USER=tipapp
DB_PASSWORD=tipapp
DB_HOST=localhost
DB_PORT=5432

# football-data.org result import
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Email
# EMAIL_BACKEND is only read by tipapp.settings.development (console backend by default).
# Production uses Django's default SMTP backend with the EMAIL_* values below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shortytipp.de
LEADERBOARD_ADMIN_EMAIL=
